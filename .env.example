# ── Frontend (Vite) ──────────────────────────────────────────────
# Skip the ERP redirect and mount with a dev user (dev only).
VITE_DEV_BYPASS=true
# Which dev user to mount as (must exist in the users table).
VITE_DEV_USER=user@dragnet-solutions.com
# ERP shell URL (used for redirect/logout when DEV_BYPASS is off).
VITE_DRAGNET_ERP_URL=http://localhost:5173
# OneDrive/SharePoint attachment connector — delegated MSAL, scoped ONLY to this feature 
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=

# ── Backend (Phase 2) ────────────────────────────────────────────
NODE_ENV=development
# Bypass JWT auth on the server (dev only; NEVER in production — the server
# refuses to start if this is true while NODE_ENV=production).
DEV_BYPASS=true
# Which dev user to mount as when DEV_BYPASS is on (must exist in the users table).
DEV_BYPASS_EMAIL=user@dragnet-solutions.com
PORT=4000
# This module's own public base URL (used in notification emails, etc).
APP_URL=http://localhost:3000

# ERP / Entra ID (from the ERP team) — also used for Graph API email sending
# and the OneDrive/SharePoint connector's delegated MSAL flow.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=
# Shared secret for POST /api/auth/revoke, from the ERP team — must match the
# ERP backend's own REVOKE_SECRET. The ERP calls this route (server-to-server)
# when a user's roles change, forcing their next request here to fail and
# re-authenticate.
REVOKE_SECRET=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=services_operations
# Full connection string built from the values above — this is what the app
# actually reads at startup (required; boot fails without it).
DATABASE_URL=mysql://root:@localhost:3306/services_operations

# QuickBooks Online
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REALM_ID=
QB_WEBHOOK_VERIFIER_TOKEN=
QB_URI=https://sandbox-quickbooks.api.intuit.com
QB_TOKEN_ENDPOINT=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
# AES-256 key for encrypting qb_tokens at rest
QB_TOKEN_ENCRYPTION_KEY=
# Must exactly match the redirect URI registered in the Intuit developer dashboard.
QB_REDIRECT_URI=http://localhost:4000/api/quickbooks/callback
